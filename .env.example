# Copy to .env and fill in. Never commit .env (NFR-11).

# Neon connection for pipeline jobs — owner role, can write.
GRIDCAST_DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require

# Neon connection for the serving API — read-only role (design doc 12.2).
# This is a DIFFERENT role, not the same URL. If these two are identical,
# the API can write to the register and the append-only guarantee is void.
GRIDCAST_READONLY_DATABASE_URL=postgresql://gridcast_readonly:password@host/neondb?sslmode=require

# Environment label surfaced by /health
GRIDCAST_ENV=local

# Build identifier, set automatically in CI/Render
GRIDCAST_COMMIT=local
